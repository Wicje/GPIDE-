# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BROKER_URL: zut run broker (projects, runs, terminal tokens, share links).
# Local: http://127.0.0.1:8787 (ZUT_BROKER_DEV_ALLOW_ANON=1 npm run broker
# in the zut-ide repo). Without it the IDE edits locally and runs are disabled.
VITE_BROKER_URL=""

# VITE_CLOUD_URL: zut cloud agent (file-editing turns). Optional; the "Cloud
# agent" model only appears when this is set.
VITE_CLOUD_URL=""

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: accounts + cloud save + sharing.
# Without them the IDE runs signed-out on this device only.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# VITE_MUDBASE_URL / VITE_MUDBASE_PROJECT_ID: Mudbase accounts (local
# email+password provider) as an alternative to Supabase. The broker verifies
# Mudbase user tokens server-side. Tab appears only when the project id is set.
VITE_MUDBASE_URL="https://api.mudbase.dev"
VITE_MUDBASE_PROJECT_ID=""

# VITE_GEMINI_API_KEY: optional build-time Gemini key (prefer the in-app
# account-settings key box or AI Studio secrets; never commit a real key).
VITE_GEMINI_API_KEY=""

# VITE_OPENCODE_URL / VITE_OPENCODE_BRIDGE_URL: self-hosted opencode agent
# (opencode serve :4096 + file bridge :4331 on your machine). The
# "opencode (self-host)" model appears only when both answer.
VITE_OPENCODE_URL="http://127.0.0.1:4096"
VITE_OPENCODE_BRIDGE_URL="http://127.0.0.1:4331"
# VITE_OPENCODE_BRIDGE_TOKEN: only if the bridge was started with a token.
VITE_OPENCODE_BRIDGE_TOKEN=""
